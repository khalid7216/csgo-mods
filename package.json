{
  "name": "csgo-mod-manager",
  "version": "1.0.0",
  "author": "Your Name",
  "description": "CSGO Mod Manager - Maps, Skins, LAN Server, Stats",
  "main": "src/main/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:react\" \"npm run dev:electron\"",
    "dev:react": "cd src/renderer && vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "build": "cd src/renderer && vite build && cd ../.. && electron-builder",
    "build:react": "cd src/renderer && vite build",
    "preview": "vite preview src/renderer"
  },
  "build": {
    "appId": "com.csgomodmanager.app",
    "productName": "CSGO Mod Manager",
    "afterSign": null,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "dir"
      ],
      "icon": "public/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "asar": true
  },
  "dependencies": {
    "electron-updater": "^6.1.7",
    "node-7z-archive": "^1.1.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.33",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "vite": "^7.3.3",
    "wait-on": "^7.2.0"
  }
}
