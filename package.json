{
  "name": "csgo-mod-manager",
  "version": "1.0.0",
  "author": "Your Name",
  "description": "CSGO Mod Manager - Maps, Skins, LAN Server, Stats",
  "main": "src/main/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:react\" \"npm run dev:electron\"",
    "dev:api": "node src/platform/apiServer.js",
    "dev:admin": "vite --config src/admin-web/vite.config.js",
    "dev:react": "cd src/renderer && vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "build": "npm run build:installer",
    "build:admin": "vite build --config src/admin-web/vite.config.js",
    "build:admin-client": "cd src/renderer && vite build && cd ../.. && electron-builder --win nsis --publish=never --config=admin-builder.json",
    "build:installer": "cd src/renderer && vite build && cd ../.. && electron-builder --win nsis --publish=never",
    "build:platform": "npm run build:react && npm run build:admin",
    "build:react": "cd src/renderer && vite build",
    "vercel-build": "npm run build:react",
    "deploy:vercel": "vercel --prod",
    "preview": "vite preview src/renderer"
  },
  "build": {
    "appId": "com.csgomodmanager.app",
    "productName": "CSGO Mod Manager",
    "afterSign": null,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "asar": true
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.1.7",
    "lucide-react": "^1.17.0",
    "tailwind-merge": "^3.6.0",
    "ws": "^8.21.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.33",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "vite": "^7.3.3",
    "wait-on": "^7.2.0"
  }
}
